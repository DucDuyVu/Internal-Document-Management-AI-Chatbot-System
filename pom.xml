<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Phiên bản chuẩn của định dạng Maven POM, luôn cố định là 4.0.0 -->

    <groupId>com.javaweb</groupId>
    <!-- "Chủ sở hữu" project, thường là tên tổ chức/nhóm, dùng làm gốc package Java -->

    <artifactId>idms</artifactId>
    <!-- Tên project: Internal Document Management System -->

    <version>1.0</version>
    <!-- Phiên bản hiện tại của project -->

    <packaging>jar</packaging>
    <!-- Đóng gói thành file .jar chạy độc lập (Spring Boot embed sẵn server bên trong) -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
    </parent>
    <!-- Kế thừa cấu hình chuẩn từ Spring Boot 3.2.5.
         Nhờ có "parent" này, các dependency Spring bên dưới không cần tự ghi version,
         Maven sẽ tự chọn version tương thích với nhau. -->

    <properties>
        <java.version>21</java.version>
        <!-- Dùng Java 21 để biên dịch và chạy toàn bộ project -->
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Bắt buộc phải có. Cho phép viết REST API (@RestController, @GetMapping...),
             tự động nhúng Tomcat server bên trong để chạy http://localhost:8080 -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Cho phép dùng Entity + Repository để thao tác database bằng Java,
             không cần viết SQL tay. Member A dùng thư viện này cho UsersEntity/UserRepository -->

        <!--
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        -->
        <!-- ĐANG TẮT (comment) để test API tự do, không bị chặn 401.
             Đây là thư viện bảo vệ API bằng đăng nhập/JWT.
             Cần bật lại ở tuần 5 khi làm phần phân quyền thật. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Validate dữ liệu đầu vào tự động bằng annotation như
             @NotBlank, @Email, @Size trên các trường trong DTO -->

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <!-- <scope>runtime</scope> -->
        </dependency>
        <!-- Driver để Java kết nối được với PostgreSQL.
             scope=runtime nghĩa là chỉ cần lúc chạy, không cần lúc biên dịch code -->

        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
            <version>0.1.6</version>
        </dependency>
        <!-- Map kiểu dữ liệu vector(768) trong PostgreSQL sang kiểu Java,
             dùng khi lưu/truy vấn embedding trong bảng document_chunks -->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Tự sinh code getter/setter/constructor bằng annotation (@Data, @Getter...),
             giúp Entity/DTO gọn hơn, không cần viết tay -->

        <dependency>
            <groupId>org.modelmapper</groupId>
            <artifactId>modelmapper</artifactId>
            <version>3.2.6</version>
        </dependency>
        <!-- Tự động chuyển đổi giữa Entity và DTO (VD: UsersEntity -> UserDTO),
             không cần viết tay từng dòng .setXxx(entity.getXxx()) -->

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <!-- 3 thư viện để tạo và xác thực JWT token.
             Dùng khi làm đăng nhập thật ở tuần 5, hiện tại chưa dùng vì Security đang tắt -->

        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.2</version>
        </dependency>
        <!-- Đọc và trích xuất text từ file PDF,
             dùng ở Ingestion Pipeline (tuần 2) khi parse tài liệu để chunking -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <!-- Tự động restart server mỗi khi sửa code và lưu file,
             không cần dừng/chạy lại mvn spring-boot:run bằng tay -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Thư viện viết unit test (JUnit, Mockito...),
             chỉ dùng lúc test, không đóng gói vào bản chạy thật -->

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!-- Plugin cho phép chạy "mvn spring-boot:run" và đóng gói app thành .jar chạy độc lập.
         Phần <excludes> loại Lombok ra khỏi file .jar cuối cùng vì Lombok chỉ cần
         lúc biên dịch code, không cần lúc chạy thật -->

</project>